{
  "name": "gold-traitors",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.15.0 <25",
    "pnpm": "11.25.0"
  },
  "scripts": {
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "build": "vite build --config apps/web/vite.config.ts",
    "build:sites": "vite build --config apps/web/vite.config.ts --mode sites",
    "e2e": "playwright test --config playwright.config.ts",
    "dev": "vite --config apps/web/vite.config.ts --host 127.0.0.1 --port 4173 --strictPort",
    "dev:server": "node --env-file-if-exists=.env --import tsx --watch apps/server/src/index.ts",
    "server": "node --env-file-if-exists=.env --import tsx apps/server/src/index.ts",
    "migrate": "node --env-file-if-exists=.env --import tsx apps/server/src/migrate.ts",
    "simulate": "tsx packages/game-core/src/simulate.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.11",
    "hono": "4.13.19",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ws": "8.23.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.4",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.8",
    "vitest": "5.1.2"
  }
}
